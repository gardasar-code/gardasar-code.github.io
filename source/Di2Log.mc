using Toybox.System;
using Toybox.Lang;

// Лёгкий логгер диагностики на устройстве.
//
// Механизм (см. doc/LOGGING.md): System.println на устройстве пишет в ЗАРАНЕЕ
// СОЗДАННЫЙ вручную файл GARMIN/APPS/LOGS/<имя_prg>.TXT. Само приложение создать
// файл не может (CIQ не даёт произвольный файловый доступ) — если файла нет,
// вывод молча теряется. Диагностическую сборку называем DI2DIAG.prg, поэтому
// лог — DI2DIAG.TXT.
//
// Каждая строка снабжается монотонным таймстампом (мс от старта системы) и
// порядковым номером — чтобы восстановить хронологию и интервалы BLE-событий
// (скан → пара → notify → разрыв → реконнект). Лимит файла ~5 КБ, при заполнении
// устройство уносит старое в .BAK — забирать оба.
//
// В release/store-сборке вызовы гасятся флагом DEBUG у вызывающего, поэтому здесь
// оверхеда нет; модуль присутствует в любой сборке, но «молчит» без вызовов.
module Di2Log {

    // Порядковый номер строки (для устойчивого упорядочивания при равных таймстампах).
    var _seq as Lang.Number = 0;

    // Сколько строк логгер уже отдал в System.println за эту сессию. Показывается на
    // diag-экране как log=N и отвечает на вопрос «логгер вообще работает?»: N=0 при
    // живой связи означает, что вызовов нет (DEBUG выключен в сборке), а N>0 при пустом
    // файле — что писать некуда: файла с нужным именем нет в GARMIN/APPS/LOGS/ либо
    // устройство ещё не сбросило его на диск.
    function count() as Lang.Number {
        return _seq;
    }

    // Записать строку лога: "<seq:4> <t_ms> | <msg>".
    // t_ms — System.getTimer(): монотонные миллисекунды, без привязки к таймзоне.
    function line(msg as Lang.String) as Void {
        _seq += 1;
        System.println(_seq.format("%04d") + " " + System.getTimer().format("%d") + " | " + msg);
    }
}
