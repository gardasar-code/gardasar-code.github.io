<?xml version="1.0" encoding="UTF-8"?>
<!-- Персистентные свойства приложения (значения по умолчанию).
     Зубья задаются списком; число передач = количество значений в списке. -->
<properties>
    <!-- Зубья передних звёзд (1x → одно число). -->
    <property id="frontTeeth" type="string">32</property>
    <!-- Зубья кассеты сзади (от меньшей звезды к большей). -->
    <property id="rearTeeth" type="string">10,12,14,16,18,21,24,28,33,39,45,51</property>
</properties>
