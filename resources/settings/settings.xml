<?xml version="1.0" encoding="UTF-8"?>
<!-- UI настроек (Garmin Connect Mobile / Express). Заголовки/подсказки локализованы.
     Сначала выбирается число звёзд, затем вводятся зубья (по значению на передачу).
     Connect IQ не валидирует количество значений между полями — проверка в коде. -->
<settings>

    <!-- Число передних звёзд. prompt = блок About (нет отдельного label-элемента). -->
    <setting propertyKey="@Properties.frontChainrings"
             title="@Strings.SetFrontChainrings"
             prompt="@Strings.AboutText">
        <settingConfig type="list">
            <listEntry value="1">1</listEntry>
            <listEntry value="2">2</listEntry>
            <listEntry value="3">3</listEntry>
        </settingConfig>
    </setting>

    <!-- Зубья передних звёзд (для 1x — одно число; для 2x/3x — через запятую). -->
    <setting propertyKey="@Properties.frontTeeth"
             title="@Strings.SetFrontTitle"
             prompt="@Strings.TeethPrompt">
        <settingConfig type="alphaNumeric" maxLength="40"/>
    </setting>

    <!-- Число задних звёзд (кассета). -->
    <setting propertyKey="@Properties.rearCogs"
             title="@Strings.SetRearCogs">
        <settingConfig type="list">
            <listEntry value="9">9</listEntry>
            <listEntry value="10">10</listEntry>
            <listEntry value="11">11</listEntry>
            <listEntry value="12">12</listEntry>
        </settingConfig>
    </setting>

    <!-- Зубья кассеты (через запятую, по значению на звезду). -->
    <setting propertyKey="@Properties.rearTeeth"
             title="@Strings.SetRearTitle"
             prompt="@Strings.TeethPrompt">
        <settingConfig type="alphaNumeric" maxLength="80"/>
    </setting>

    <!-- Forget: одноразовый тоггл сброса привязки. Включи и сохрани — поле забудет
         текущий Di2 и при следующем скане подключится к ближайшему. -->
    <setting propertyKey="@Properties.forgetDevice"
             title="@Strings.SetForgetDevice"
             prompt="@Strings.ForgetPrompt">
        <settingConfig type="boolean"/>
    </setting>

    <!-- Показ батареи: процент / иконка / иконка+процент.
         Метки опций инлайн (как у числа звёзд), заголовок локализован. -->
    <setting propertyKey="@Properties.batteryDisplay"
             title="@Strings.SetBattery">
        <settingConfig type="list">
            <listEntry value="0">@Strings.OptBatteryPercent</listEntry>
            <listEntry value="1">@Strings.OptBatteryIcon</listEntry>
            <listEntry value="2">@Strings.OptBatteryBoth</listEntry>
        </settingConfig>
    </setting>

    <!-- Показ задней передачи: цифры / график (визуальная кассета) / оба. -->
    <setting propertyKey="@Properties.displayMode"
             title="@Strings.SetDisplay">
        <settingConfig type="list">
            <listEntry value="0">@Strings.OptDisplayNumbers</listEntry>
            <listEntry value="1">@Strings.OptDisplayGraphic</listEntry>
            <listEntry value="2">@Strings.OptDisplayBoth</listEntry>
        </settingConfig>
    </setting>

</settings>
