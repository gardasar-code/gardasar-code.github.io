<?xml version="1.0" encoding="UTF-8"?>
<!-- UI настроек (Garmin Connect Mobile / Express). Заголовки локализованы.
     Зубья вводятся списком через запятую (парсер принимает любой разделитель). -->
<settings>

    <!-- Зубья передних звёзд (1x → одно число, напр. 32). prompt = блок About. -->
    <setting propertyKey="@Properties.frontTeeth"
             title="@Strings.SetFrontTitle"
             prompt="@Strings.AboutText">
        <settingConfig type="alphaNumeric" maxLength="40"/>
    </setting>

    <!-- Зубья кассеты сзади (от меньшей звезды к большей). -->
    <setting propertyKey="@Properties.rearTeeth"
             title="@Strings.SetRearTitle">
        <settingConfig type="alphaNumeric" maxLength="80"/>
    </setting>

</settings>
